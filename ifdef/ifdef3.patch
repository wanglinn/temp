 /* 文件末尾新增辅助函数 */
 
+/*
+ * 评估 #if 表达式
+ * 支持: defined(XX), !defined(XX), &&, ||, !, 括号
+ */
+static bool
+eval_cpp_if_expr(const char *expr)
+{
+    const char *p = expr;
+    bool result = false;
+    bool pending_and = false;
+    bool pending_or = false;
+    bool negate_next = false;
+    
+    while (*p) {
+        /* 跳过空白 */
+        while (*p && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r'))
+            p++;
+        
+        if (!*p)
+            break;
+        
+        /* 检查 ! */
+        if (*p == '!') {
+            negate_next = !negate_next;
+            p++;
+            continue;
+        }
+        
+        /* 检查 ( */
+        if (*p == '(') {
+            p++;
+            /* 找到匹配的 ) */
+            const char *start = p;
+            int depth = 1;
+            while (*p && depth > 0) {
+                if (*p == '(') depth++;
+                else if (*p == ')') depth--;
+                p++;
+            }
+            if (depth > 0)
+                return false;  /* 未匹配的括号 */
+            
+            int len = p - start - 1;  /* 不包括最后的 ) */
+            char *subexpr = (char *) mm_alloc(len + 1);
+            strncpy(subexpr, start, len);
+            subexpr[len] = '\0';
+            
+            bool subresult = eval_cpp_if_expr(subexpr);
+            if (negate_next) {
+                subresult = !subresult;
+                negate_next = false;
+            }
+            
+            if (pending_and) {
+                result = result && subresult;
+                pending_and = false;
+            } else if (pending_or) {
+                result = result || subresult;
+                pending_or = false;
+            } else {
+                result = subresult;
+            }
+            
+            free(subexpr);
+            continue;
+        }
+        
+        /* 检查 defined(XXX) */
+        if (strncmp(p, "defined", 7) == 0 && 
+            !isalnum((unsigned char)p[7]) && p[7] != '_') {
+            p += 7;
+            while (*p && (*p == ' ' || *p == '\t')) p++;
+            
+            if (*p != '(')
+                return false;
+            p++;
+            
+            const char *start = p;
+            while (*p && (isalnum((unsigned char)*p) || *p == '_'))
+                p++;
+            int len = p - start;
+            if (len <= 0)
+                return false;
+            
+            char *name = (char *) mm_alloc(len + 1);
+            strncpy(name, start, len);
+            name[len] = '\0';
+            
+            bool defined = is_macro_defined(name);
+            if (negate_next) {
+                defined = !defined;
+                negate_next = false;
+            }
+            
+            if (pending_and) {
+                result = result && defined;
+                pending_and = false;
+            } else if (pending_or) {
+                result = result || defined;
+                pending_or = false;
+            } else {
+                result = defined;
+            }
+            
+            free(name);
+            
+            while (*p && (*p == ' ' || *p == '\t')) p++;
+            if (*p == ')') p++;
+            continue;
+        }
+        
+        /* 检查 && */
+        if (*p == '&' && *(p+1) == '&') {
+            pending_and = true;
+            p += 2;
+            continue;
+        }
+        
+        /* 检查 || */
+        if (*p == '|' && *(p+1) == '|') {
+            pending_or = true;
+            p += 2;
+            continue;
+        }
+        
+        /* 未知标记，跳过 */
+        p++;
+    }
+    
+    return result;
+}
