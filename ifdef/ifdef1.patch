@@ -...,... @@
 /* 文件末尾新增辅助函数 */
 
+static bool
+is_cpp_ifdef_line(const char *line, char **macro_name)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    if (strncmp(p, "ifdef", 5) != 0 || 
+        (isalnum((unsigned char)p[5]) || p[5] == '_'))
+        return false;
+    p += 5;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    const char *start = p;
+    while (*p && (isalnum((unsigned char)*p) || *p == '_'))
+        p++;
+    
+    int len = p - start;
+    if (len <= 0)
+        return false;
+    
+    *macro_name = (char *) mm_alloc(len + 1);
+    strncpy(*macro_name, start, len);
+    (*macro_name)[len] = '\0';
+    
+    return true;
+}
+
+static bool
+is_cpp_else_line(const char *line)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    return (strncmp(p, "else", 4) == 0 && 
+            !isalnum((unsigned char)p[4]) && p[4] != '_');
+}
+
+static bool
+is_cpp_endif_line(const char *line)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    return (strncmp(p, "endif", 5) == 0 && 
+            !isalnum((unsigned char)p[5]) && p[5] != '_');
+}
+
+static bool
+is_macro_defined(const char *name)
+{
+    struct _defines *defptr;
+    
+    for (defptr = defines; defptr; defptr = defptr->next) {
+        if (strcmp(name, defptr->name) == 0 && defptr->value != NULL)
+            return true;
+    }
+    return false;
+}


关键修改点总结

| 修改                          | 说明                                                                                  |
| --------------------------- | ----------------------------------------------------------------------------------- |
| `c_ifdef_skip_depth`        | 全局计数器，区分 C 原生 `#ifdef` 和 `EXEC SQL IFDEF` 的跳过行为                                     |
| `<C,SQL>{cppline}`          | 识别 `#ifdef` / `#else` / `#endif`，操作 `stacked_if_value` 栈                            |
| `<xskip>{cppline}`          | `xskip` 状态下也能处理 `#else` / `#endif`，避免状态不匹配                                          |
| `<xskip>{exec_sql}[^\n]*\n` | 添加 `c_ifdef_skip_depth` 判断，C 原生时透传                                                  |
| `<xskip>[^\n]+\n`           | C 原生跳过时透传普通 C 代码行                                                                   |
| `<xskip>\n`                 | 透传空行                                                                                |
| `<xskip>.`                  | 透传单个字符                                                                              |
| 辅助函数                        | `is_cpp_ifdef_line` / `is_cpp_else_line` / `is_cpp_endif_line` / `is_macro_defined` |



