以下是完整的 ecpg 修改 patch，支持 C 原生 #ifdef / #else / #endif 条件编译，与 EXEC SQL IFDEF 共存且互不干扰：



--- a/src/interfaces/ecpg/preproc/pgc.l
+++ b/src/interfaces/ecpg/preproc/pgc.l
@@ -95,6 +95,9 @@ static bool ecpg_isspace(char ch);
 static bool isdefine(void);
 static bool isinformixdefine(void);
 
+/* C 原生 #ifdef 透传模式深度计数器 */
+static int c_ifdef_skip_depth = 0;
+
 /* C 原生 #ifdef 支持辅助函数 */
 static bool is_cpp_ifdef_line(const char *line, char **macro_name);
 static bool is_cpp_else_line(const char *line);
@@ -...,... @@
 <C,SQL>{cppline} {
-    base_yylval.str = loc_strdup(yytext);
-    return CPP_LINE;
+    char *macro_name = NULL;
+    
+    if (is_cpp_ifdef_line(yytext, &macro_name)) {
+        bool defined = is_macro_defined(macro_name);
+        
+        if (preproc_tos >= MAX_NESTED_IF - 1)
+            mmfatal(PARSE_ERROR, "too many nested #ifdef conditions");
+        
+        preproc_tos++;
+        stacked_if_value[preproc_tos].active = false;
+        stacked_if_value[preproc_tos].saw_active = false;
+        stacked_if_value[preproc_tos].else_branch = false;
+        
+        bool outer_active = (preproc_tos <= 0) || 
+                            stacked_if_value[preproc_tos - 1].active;
+        bool this_active = outer_active && defined;
+        
+        stacked_if_value[preproc_tos].active = this_active;
+        stacked_if_value[preproc_tos].saw_active = this_active;
+        
+        fputs(yytext, yyout);
+        
+        if (this_active)
+            BEGIN(C);
+        else {
+            c_ifdef_skip_depth++;
+            BEGIN(xskip);
+        }
+        
+        free(macro_name);
+    }
+    else if (is_cpp_else_line(yytext)) {
+        if (preproc_tos <= 0) {
+            mmfatal(PARSE_ERROR, "unmatched #else");
+        }
+        else if (stacked_if_value[preproc_tos].else_branch) {
+            mmfatal(PARSE_ERROR, "duplicate #else");
+        }
+        else {
+            stacked_if_value[preproc_tos].else_branch = true;
+            
+            bool outer_active = (preproc_tos <= 0) || 
+                                stacked_if_value[preproc_tos - 1].active;
+            bool any_taken = stacked_if_value[preproc_tos].saw_active;
+            bool this_active = outer_active && !any_taken;
+            
+            stacked_if_value[preproc_tos].active = this_active;
+            if (this_active)
+                stacked_if_value[preproc_tos].saw_active = true;
+            
+            fputs(yytext, yyout);
+            
+            if (this_active) {
+                c_ifdef_skip_depth--;
+                BEGIN(C);
+            } else {
+                BEGIN(xskip);
+            }
+        }
+    }
+    else if (is_cpp_endif_line(yytext)) {
+        if (preproc_tos <= 0) {
+            mmfatal(PARSE_ERROR, "unmatched #endif");
+        }
+        else {
+            preproc_tos--;
+            
+            fputs(yytext, yyout);
+            
+            c_ifdef_skip_depth--;
+            
+            bool active = (preproc_tos <= 0) || 
+                          stacked_if_value[preproc_tos].active;
+            if (active)
+                BEGIN(C);
+            else
+                BEGIN(xskip);
+        }
+    }
+    else {
+        base_yylval.str = loc_strdup(yytext);
+        return CPP_LINE;
+    }
 }
 
