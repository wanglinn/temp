 /* 文件末尾新增辅助函数 */
 
+static bool
+is_cpp_cond_line(const char *line, char **macro_name, int *cond_type)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    /* 检查 #ifdef */
+    if (strncmp(p, "ifdef", 5) == 0 && 
+        !isalnum((unsigned char)p[5]) && p[5] != '_') {
+        *cond_type = C_IFDEF_IFDEF;
+        p += 5;
+    }
+    /* 检查 #ifndef */
+    else if (strncmp(p, "ifndef", 6) == 0 && 
+             !isalnum((unsigned char)p[6]) && p[6] != '_') {
+        *cond_type = C_IFDEF_IFNDEF;
+        p += 6;
+    }
+    /* 检查 #elif */
+    else if (strncmp(p, "elif", 4) == 0 && 
+             !isalnum((unsigned char)p[4]) && p[4] != '_') {
+        *cond_type = C_IFDEF_ELIF;
+        p += 4;
+    }
+    else {
+        return false;
+    }
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    const char *start = p;
+    while (*p && (isalnum((unsigned char)*p) || *p == '_'))
+        p++;
+    
+    int len = p - start;
+    if (len <= 0)
+        return false;
+    
+    *macro_name = (char *) mm_alloc(len + 1);
+    strncpy(*macro_name, start, len);
+    (*macro_name)[len] = '\0';
+    
+    return true;
+}
+
+static bool
+is_cpp_else_line(const char *line)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    return (strncmp(p, "else", 4) == 0 && 
+            !isalnum((unsigned char)p[4]) && p[4] != '_');
+}
+
+static bool
+is_cpp_endif_line(const char *line)
+{
+    const char *p = line;
+    
+    while (*p && ecpg_isspace(*p))
+        p++;
+    
+    if (*p != '#')
+        return false;
+    p++;
+    
+    while (*p && (*p == ' ' || *p == '\t'))
+        p++;
+    
+    return (strncmp(p, "endif", 5) == 0 && 
+            !isalnum((unsigned char)p[5]) && p[5] != '_');
+}
+
+static bool
+is_macro_defined(const char *name)
+{
+    struct _defines *defptr;
+    
+    for (defptr = defines; defptr; defptr = defptr->next) {
+        if (strcmp(name, defptr->name) == 0 && defptr->value != NULL)
+            return true;
+    }
+    return false;
+}
