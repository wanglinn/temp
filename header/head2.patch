index 0000000..003e293
--- /dev/null
+++ b/src/interfaces/ecpg/preproc/preproc_import.c
@@ -0,0 +1,1032 @@
+/*
+ * preproc_import.c
+ *
+ * Tolerant extraction of struct/union/enum/typedef definitions from
+ * C header files included via #include "...".
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ *
+ * src/interfaces/ecpg/preproc/preproc_import.c
+ */
+
+#include "postgres_fe.h"
+
+#include <ctype.h>
+#include <unistd.h>
+
+#include "lib/stringinfo.h"
+#include "port.h"
+
+#include "preproc_extern.h"
+#include "preproc_import.h"
+
+/*
+ * Conditional-compilation stack depth.  Must be enough for real headers;
+ * 128 matches the existing EXEC SQL IFDEF limit.
+ */
+#define MAX_COND_DEPTH 128
+
+/*
+ * Local macro table for a single scan.  We copy the global "defines" list at
+ * start and update it with #define/#undef encountered inside the header, so
+ * that header macros do not leak into ECPG's main preprocessor state.
+ */
+typedef struct ImportDefine
+{
+	char			*name;
+	char			*value;		/* NULL means undefined */
+	struct ImportDefine *next;
+} ImportDefine;
+
+typedef struct ImportCond
+{
+	bool			active;		/* branch currently active */
+	bool			saw_active;	/* any active branch seen at this level */
+	bool			else_branch;	/* already saw #else */
+} ImportCond;
+
+typedef struct VisitedPath
+{
+	char			*path;
+	struct VisitedPath *next;
+} VisitedPath;
+
+typedef struct ImportScanContext
+{
+	const char		*filename;	/* file being scanned */
+	const char		*p;		/* current scan position */
+	int				 lineno;
+
+	StringInfoData	 decls;		/* extracted declarations */
+
+	ImportCond		 cond_stack[MAX_COND_DEPTH];
+	int				 cond_tos;
+
+	ImportDefine	*defines;	/* local macro table */
+
+	VisitedPath		*visited;	/* absolute paths already scanned */
+
+	int				 brace_depth;
+	int				 paren_depth;
+} ImportScanContext;
+
+bool				 import_struct_includes = false;
+
+static void import_scan_file(ImportScanContext *ctx, const char *filename);
+static void import_scan_content(ImportScanContext *ctx,
+								const char *content, const char *filename);
+static void import_handle_preproc(ImportScanContext *ctx);
+static void import_extract_declaration(ImportScanContext *ctx);
+static bool import_starts_type_definition(ImportScanContext *ctx);
+
+static bool import_is_defined(ImportScanContext *ctx, const char *name);
+static void import_define(ImportScanContext *ctx,
+						  const char *name, const char *value);
+static void import_undefine(ImportScanContext *ctx, const char *name);
+static void import_copy_global_defines(ImportScanContext *ctx);
+
+static char *import_resolve_include(ImportScanContext *ctx,
+									const char *filename, bool quoted);
+static char *import_try_open(const char *path);
+static bool import_already_visited(ImportScanContext *ctx, const char *path);
+static void import_mark_visited(ImportScanContext *ctx, const char *path);
+
+static void import_skip_block_comment(ImportScanContext *ctx);
+static void import_skip_line_comment(ImportScanContext *ctx);
+static void import_skip_string(ImportScanContext *ctx, char quote);
+
+static bool import_is_word_at(const char *p, const char *word);
+
+static void import_push_cond(ImportScanContext *ctx, bool this_branch_active);
+static void import_switch_cond(ImportScanContext *ctx, bool this_branch_active);
+static void import_else_cond(ImportScanContext *ctx);
+static void import_pop_cond(ImportScanContext *ctx);
+
+static void import_skip_space_at(ImportScanContext *ctx, const char **pp);
+static bool import_get_word_at_p(ImportScanContext *ctx, const char **pp,
+								 char *buf, size_t bufsize);
+static bool import_get_word_at(const char *p, char *buf, size_t bufsize);
+static bool import_eval_if_defined(ImportScanContext *ctx, const char *p);
+
+static void import_skip_block_comment_at(const char **pp, int *lineno);
+static void import_skip_line_comment_at(const char **pp, int *lineno);
+static void import_skip_string_at(const char **pp, char quote, int *lineno);
+
+
+/*
+ * Public entry point: extract struct/union/enum/typedef declarations from a
+ * header file.  Returns a pointer to an mm_alloc'd string (possibly empty),
+ * or NULL if the file cannot be opened.  The caller must not free the result.
+ */
+char *
+ecpg_extract_struct_decls(const char *filename)
+{
+	ImportScanContext ctx;
+
+	memset(&ctx, 0, sizeof(ctx));
+	initStringInfo(&ctx.decls);
+	ctx.cond_tos = 0;
+	ctx.cond_stack[0].active = true;
+	ctx.cond_stack[0].saw_active = true;
+	ctx.cond_stack[0].else_branch = false;
+	ctx.brace_depth = 0;
+	ctx.paren_depth = 0;
+
+	import_copy_global_defines(&ctx);
+
+	import_scan_file(&ctx, filename);
+
+	/* Free local macro table. */
+	while (ctx.defines)
+	{
+		ImportDefine *d = ctx.defines;
+		ctx.defines = d->next;
+		free(d->name);
+		if (d->value)
+			free(d->value);
+		free(d);
+	}
+
+	/* Free visited list. */
+	while (ctx.visited)
+	{
+		VisitedPath *v = ctx.visited;
+		ctx.visited = v->next;
+		free(v->path);
+		free(v);
+	}
+
+	/*
+	 * Return mm_alloc'd copy.  StringInfo uses frontend malloc, but ECPG callers
+	 * expect mm_alloc style; copy once and let StringInfo buffer be freed at
+	 * function exit.
+	 */
+	return mm_strdup(ctx.decls.data);
+}
+
+/*
+ * Scan a single file, identified by its (possibly relative) filename.
+ */
+static void
+import_scan_file(ImportScanContext *ctx, const char *filename)
+{
+	char			*resolved;
+	char			*content;
+	const char		*saved_filename;
+
+	resolved = import_resolve_include(ctx, filename, true);
+	if (!resolved)
+		return;
+
+	fprintf(stderr, "[import] resolving '%s' -> '%s'\n", filename, resolved);
+
+	if (import_already_visited(ctx, resolved))
+	{
+		free(resolved);
+		return;
+	}
+	import_mark_visited(ctx, resolved);
+
+	content = import_try_open(resolved);
+	if (!content)
+	{
+		free(resolved);
+		return;
+	}
+
+	saved_filename = ctx->filename;
+	int				saved_lineno = ctx->lineno;
+	import_scan_content(ctx, content, resolved);
+	ctx->filename = saved_filename;
+	ctx->lineno = saved_lineno;
+
+	free(content);
+	free(resolved);
+}
+
+/*
+ * Read a file into a malloc'd, null-terminated buffer.
+ */
+static char *
+import_try_open(const char *path)
+{
+	FILE			*fp;
+	long			 len;
+	char			*buf;
+
+	fp = fopen(path, "r");
+	if (!fp)
+		return NULL;
+
+	if (fseek(fp, 0, SEEK_END) != 0 ||
+		(len = ftell(fp)) < 0 ||
+		fseek(fp, 0, SEEK_SET) != 0)
+	{
+		fclose(fp);
+		return NULL;
+	}
+
+	buf = (char *) malloc(len + 1);
+	if (!buf)
+	{
+		fclose(fp);
+		return NULL;
+	}
+
+	if (fread(buf, 1, len, fp) != (size_t) len)
+	{
+		free(buf);
+		fclose(fp);
+		return NULL;
+	}
+	buf[len] = '\0';
+	fclose(fp);
+
+	return buf;
+}
+
+/*
+ * Resolve an include filename.  For quoted includes we try:
+ *   1. As-is (relative to cwd or the including file's directory)
+ *   2. Each -I path
+ * We do not search system default paths for quoted includes, matching ECPG's
+ * existing EXEC SQL INCLUDE behavior.
+ */
+static char *
+import_resolve_include(ImportScanContext *ctx, const char *filename, bool quoted)
+{
+	struct _include_path *ip;
+	char				  inc_file[MAXPGPATH];
+	char				  dir[MAXPGPATH];
+	char				 *abs;
+	FILE				 *fp;
+
+	(void) quoted;				/* reserved for future <...> handling */
+
+	/* Try filename as-is. */
+	fp = fopen(filename, "r");
+	if (fp)
+	{
+		fclose(fp);
+		abs = make_absolute_path(filename);
+		if (abs)
+			return abs;
+	}
+
+	/* Try relative to the including file's directory. */
+	if (ctx->filename)
+	{
+		strlcpy(dir, ctx->filename, sizeof(dir));
+		get_parent_directory(dir);
+		if (strlen(dir) > 0)
+		{
+			snprintf(inc_file, sizeof(inc_file), "%s/%s", dir, filename);
+			fp = fopen(inc_file, "r");
+			if (fp)
+			{
+				fclose(fp);
+				return make_absolute_path(inc_file);
+			}
+		}
+	}
+
+	/* Try include paths. */
+	for (ip = include_paths; ip != NULL; ip = ip->next)
+	{
+		if (strlen(ip->path) + strlen(filename) + 2 > MAXPGPATH)
+			continue;
+		snprintf(inc_file, sizeof(inc_file), "%s/%s", ip->path, filename);
+		fp = fopen(inc_file, "r");
+		if (fp)
+		{
+			fclose(fp);
+			return make_absolute_path(inc_file);
+		}
+		/* Try with .h appended. */
+		if (strlen(filename) <= 2 || strcmp(filename + strlen(filename) - 2, ".h") != 0)
+		{
+			snprintf(inc_file, sizeof(inc_file), "%s/%s.h", ip->path, filename);
+			fp = fopen(inc_file, "r");
+			if (fp)
+			{
+				fclose(fp);
+				return make_absolute_path(inc_file);
+			}
+		}
+	}
+
+	return NULL;
+}
+
+static bool
+import_already_visited(ImportScanContext *ctx, const char *path)
+{
+	VisitedPath *v;
+
+	for (v = ctx->visited; v; v = v->next)
+	{
+		if (strcmp(v->path, path) == 0)
+			return true;
+	}
+	return false;
+}
+
+static void
+import_mark_visited(ImportScanContext *ctx, const char *path)
+{
+	VisitedPath *v = (VisitedPath *) malloc(sizeof(VisitedPath));
+	v->path = strdup(path);
+	v->next = ctx->visited;
+	ctx->visited = v;
+}
+
+/*
+ * Main content scanner.
+ */
+static void
+import_scan_content(ImportScanContext *ctx, const char *content,
+					const char *filename)
+{
+	ctx->filename = filename;
+	ctx->p = content;
+	ctx->lineno = 1;
+
+	while (*ctx->p)
+	{
+		/* Whitespace. */
+		if (isspace((unsigned char) *ctx->p))
+		{
+			if (*ctx->p == '\n')
+				ctx->lineno++;
+			ctx->p++;
+			continue;
+		}
+
+		/* Comments and literals. */
+		if (ctx->p[0] == '/' && ctx->p[1] == '*')
+		{
+			import_skip_block_comment(ctx);
+			continue;
+		}
+		if (ctx->p[0] == '/' && ctx->p[1] == '/')
+		{
+			import_skip_line_comment(ctx);
+			continue;
+		}
+		if (*ctx->p == '"')
+		{
+			import_skip_string(ctx, '"');
+			continue;
+		}
+		if (*ctx->p == '\'')
+		{
+			import_skip_string(ctx, '\'');
+			continue;
+		}
+
+		/* Track brace/paren depth outside of inactive branches. */
+		if (ctx->cond_stack[ctx->cond_tos].active)
+		{
+			if (*ctx->p == '{')
+			{
+				ctx->brace_depth++;
+				ctx->p++;
+				continue;
+			}
+			if (*ctx->p == '}')
+			{
+				ctx->brace_depth--;
+				ctx->p++;
+				continue;
+			}
+			if (*ctx->p == '(')
+			{
+				ctx->paren_depth++;
+				ctx->p++;
+				continue;
+			}
+			if (*ctx->p == ')')
+			{
+				ctx->paren_depth--;
+				ctx->p++;
+				continue;
+			}
+		}
+
+		/* Preprocessor directive. */
+		if (*ctx->p == '#')
+		{
+			import_handle_preproc(ctx);
+			continue;
+		}
+
+		/*
+		 * Only extract declarations in active branches and at top-level depth.
+		 */
+		if (ctx->cond_stack[ctx->cond_tos].active &&
+			ctx->brace_depth == 0 &&
+			ctx->paren_depth == 0)
+		{
+			bool starts = import_starts_type_definition(ctx);
+			if (starts)
+			{
+				fprintf(stderr, "[import] extracting at %s:%d\n", ctx->filename, ctx->lineno);
+				import_extract_declaration(ctx);
+				continue;
+			}
+			else if (import_is_word_at(ctx->p, "struct") ||
+					 import_is_word_at(ctx->p, "union") ||
+					 import_is_word_at(ctx->p, "enum") ||
+					 import_is_word_at(ctx->p, "typedef"))
+			{
+				fprintf(stderr, "[import] skipped keyword at %s:%d (next='%c')\n",
+						ctx->filename, ctx->lineno, *ctx->p);
+			}
+		}
+
+		ctx->p++;
+	}
+}
+
+/*
+ * Skip helpers.
+ */
+static void
+import_skip_block_comment(ImportScanContext *ctx)
+{
+	ctx->p += 2;
+	while (*ctx->p)
+	{
+		if (ctx->p[0] == '*' && ctx->p[1] == '/')
+		{
+			ctx->p += 2;
+			return;
+		}
+		if (*ctx->p == '\n')
+			ctx->lineno++;
+		ctx->p++;
+	}
+}
+
+static void
+import_skip_line_comment(ImportScanContext *ctx)
+{
+	ctx->p += 2;
+	while (*ctx->p && *ctx->p != '\n')
+		ctx->p++;
+}
+
+static void
+import_skip_string(ImportScanContext *ctx, char quote)
+{
+	ctx->p++;
+	while (*ctx->p)
+	{
+		if (*ctx->p == '\\' && ctx->p[1])
+		{
+			ctx->p += 2;
+			continue;
+		}
+		if (*ctx->p == quote)
+		{
+			ctx->p++;
+			return;
+		}
+		if (*ctx->p == '\n')
+			ctx->lineno++;
+		ctx->p++;
+	}
+}
+
+/*
+ * Check whether p points to a complete word (not a prefix of an identifier).
+ */
+static bool
+import_is_word_at(const char *p, const char *word)
+{
+	size_t			  len = strlen(word);
+
+	if (strncmp(p, word, len) != 0)
+		return false;
+	return !isalnum((unsigned char) p[len]) && p[len] != '_';
+}
+
+/*
+ * Handle a preprocessor line starting at '#'.
+ */
+static void
+import_handle_preproc(ImportScanContext *ctx)
+{
+	const char		 *line_start;
+	const char		 *line_end;
+	const char		 *q;
+	char			  word[128];
+	char			  name[128];
+	bool			  was_active;
+	bool			  cond_value;
+
+	/* Find end of line (respect \ continuations). */
+	line_start = ctx->p;
+	line_end = ctx->p;
+	while (*line_end)
+	{
+		if (*line_end == '\\' && line_end[1] == '\n')
+		{
+			line_end += 2;
+			ctx->lineno++;
+			continue;
+		}
+		if (*line_end == '\n')
+			break;
+		line_end++;
+	}
+
+	q = line_start + 1;
+	import_skip_space_at(ctx, &q); /* custom: skip spaces without updating lineno */
+
+	/* Read directive word. */
+	if (!import_get_word_at_p(ctx, &q, word, sizeof(word)))
+	{
+		ctx->p = line_end;
+		if (*ctx->p == '\n')
+		{
+			ctx->lineno++;
+			ctx->p++;
+		}
+		return;
+	}
+
+	was_active = ctx->cond_stack[ctx->cond_tos].active;
+
+	if (strcmp(word, "ifdef") == 0)
+	{
+		if (!import_get_word_at_p(ctx, &q, name, sizeof(name)))
+			goto done;
+		cond_value = import_is_defined(ctx, name);
+		import_push_cond(ctx, cond_value);
+	}
+	else if (strcmp(word, "ifndef") == 0)
+	{
+		if (!import_get_word_at_p(ctx, &q, name, sizeof(name)))
+			goto done;
+		cond_value = !import_is_defined(ctx, name);
+		import_push_cond(ctx, cond_value);
+	}
+	else if (strcmp(word, "if") == 0)
+	{
+		/*
+		* Support only #if defined(NAME) and #if !defined(NAME).  Anything
+		* else is conservatively treated as true.
+		*/
+		cond_value = import_eval_if_defined(ctx, q);
+		import_push_cond(ctx, cond_value);
+	}
+	else if (strcmp(word, "elif") == 0)
+	{
+		if (ctx->cond_tos == 0)
+			goto done;
+		if (ctx->cond_stack[ctx->cond_tos].else_branch)
+			goto done;
+		cond_value = import_eval_if_defined(ctx, q);
+		import_switch_cond(ctx, cond_value);
+	}
+	else if (strcmp(word, "else") == 0)
+	{
+		if (ctx->cond_tos == 0)
+			goto done;
+		import_else_cond(ctx);
+	}
+	else if (strcmp(word, "endif") == 0)
+	{
+		if (ctx->cond_tos == 0)
+			goto done;
+		import_pop_cond(ctx);
+	}
+	else if (was_active && strcmp(word, "include") == 0)
+	{
+		char			  inc_file[MAXPGPATH];
+
+		import_skip_space_at(ctx, &q);
+		if (*q == '"')
+		{
+			const char		 *start = ++q;
+			while (*q && *q != '"')
+				q++;
+			if (*q == '"')
+			{
+				size_t			  len = q - start;
+
+				if (len >= sizeof(inc_file))
+					len = sizeof(inc_file) - 1;
+				memcpy(inc_file, start, len);
+				inc_file[len] = '\0';
+				import_scan_file(ctx, inc_file);
+			}
+		}
+	}
+	else if (was_active && strcmp(word, "define") == 0)
+	{
+		char			  value[1024];
+		const char		 *val_start;
+		size_t			  val_len;
+
+		import_skip_space_at(ctx, &q);
+		if (import_get_word_at_p(ctx, &q, name, sizeof(name)))
+		{
+			val_start = q;
+			val_len = line_end - val_start;
+			while (val_len > 0 && isspace((unsigned char) val_start[val_len - 1]))
+				val_len--;
+			if (val_len >= sizeof(value))
+				val_len = sizeof(value) - 1;
+			memcpy(value, val_start, val_len);
+			value[val_len] = '\0';
+			import_define(ctx, name, value);
+		}
+	}
+	else if (was_active && strcmp(word, "undef") == 0)
+	{
+		if (import_get_word_at_p(ctx, &q, name, sizeof(name)))
+			import_undefine(ctx, name);
+	}
+
+	/* #line and #pragma are ignored. */
+
+done:
+	ctx->p = line_end;
+	if (*ctx->p == '\n')
+	{
+		ctx->lineno++;
+		ctx->p++;
+	}
+}
+
+/*
+ * Variants of skip/get that operate on a local pointer without touching
+ * ctx->lineno.  They are used while parsing a single preprocessor line.
+ */
+static void
+import_skip_space_at(ImportScanContext *ctx, const char **pp)
+{
+	(void) ctx;
+	while (**pp && isspace((unsigned char) **pp))
+		(*pp)++;
+}
+
+static bool
+import_get_word_at(const char *p, char *buf, size_t bufsize)
+{
+	size_t			  i = 0;
+
+	while (*p && isspace((unsigned char) *p))
+		p++;
+	if (!*p || !(isalpha((unsigned char) *p) || *p == '_'))
+		return false;
+
+	while (*p && (isalnum((unsigned char) *p) || *p == '_'))
+	{
+		if (i + 1 < bufsize)
+			buf[i++] = *p;
+		p++;
+	}
+	buf[i] = '\0';
+	return true;
+}
+
+static bool
+import_get_word_at_p(ImportScanContext *ctx, const char **pp, char *buf,
+					 size_t bufsize)
+{
+	bool			  result;
+
+	result = import_get_word_at(*pp, buf, bufsize);
+	if (result)
+	{
+		/* Advance past the word we just read. */
+		import_skip_space_at(ctx, pp);
+		while (**pp && (isalnum((unsigned char) **pp) || **pp == '_'))
+			(*pp)++;
+	}
+	return result;
+}
+
+static bool
+import_eval_if_defined(ImportScanContext *ctx, const char *p)
+{
+	bool			  not_flag = false;
+	char			  name[128];
+
+	while (*p && isspace((unsigned char) *p))
+		p++;
+
+	if (*p == '!')
+	{
+		not_flag = true;
+		p++;
+		while (*p && isspace((unsigned char) *p))
+			p++;
+	}
+
+	if (strncmp(p, "defined", 7) == 0 && !isalnum((unsigned char) p[7]) && p[7] != '_')
+	{
+		p += 7;
+		while (*p && isspace((unsigned char) *p))
+			p++;
+		if (*p == '(')
+		{
+			p++;
+			while (*p && isspace((unsigned char) *p))
+				p++;
+		}
+		if (import_get_word_at(p, name, sizeof(name)))
+			return not_flag ? !import_is_defined(ctx, name) : import_is_defined(ctx, name);
+	}
+
+	/* Conservative default: treat unknown expressions as active. */
+	return true;
+}
+
+/*
+ * Conditional-stack helpers.
+ */
+static void
+import_push_cond(ImportScanContext *ctx, bool this_branch_active)
+{
+	bool			  parent_active;
+
+	if (ctx->cond_tos >= MAX_COND_DEPTH - 1)
+		mmfatal(PARSE_ERROR, "too many nested #ifdef conditions in imported header");
+
+	parent_active = ctx->cond_stack[ctx->cond_tos].active;
+	ctx->cond_tos++;
+	ctx->cond_stack[ctx->cond_tos].saw_active = false;
+	ctx->cond_stack[ctx->cond_tos].else_branch = false;
+	ctx->cond_stack[ctx->cond_tos].active =
+		parent_active && !ctx->cond_stack[ctx->cond_tos].saw_active && this_branch_active;
+	ctx->cond_stack[ctx->cond_tos].saw_active = this_branch_active;
+}
+
+static void
+import_switch_cond(ImportScanContext *ctx, bool this_branch_active)
+{
+	bool			  parent_active;
+
+	parent_active = ctx->cond_stack[ctx->cond_tos - 1].active;
+	ctx->cond_stack[ctx->cond_tos].active =
+		parent_active && !ctx->cond_stack[ctx->cond_tos].saw_active && this_branch_active;
+	ctx->cond_stack[ctx->cond_tos].saw_active |= this_branch_active;
+}
+
+static void
+import_else_cond(ImportScanContext *ctx)
+{
+	bool			  parent_active;
+
+	if (ctx->cond_stack[ctx->cond_tos].else_branch)
+		mmfatal(PARSE_ERROR, "more than one #else in imported header");
+
+	ctx->cond_stack[ctx->cond_tos].else_branch = true;
+	parent_active = ctx->cond_stack[ctx->cond_tos - 1].active;
+	ctx->cond_stack[ctx->cond_tos].active =
+		parent_active && !ctx->cond_stack[ctx->cond_tos].saw_active;
+	ctx->cond_stack[ctx->cond_tos].saw_active = true;
+}
+
+static void
+import_pop_cond(ImportScanContext *ctx)
+{
+	if (ctx->cond_tos == 0)
+		mmfatal(PARSE_ERROR, "unmatched #endif in imported header");
+	ctx->cond_tos--;
+}
+
+/*
+ * Local macro table helpers.
+ */
+static void
+import_copy_global_defines(ImportScanContext *ctx)
+{
+	struct _defines *g;
+
+	ctx->defines = NULL;
+	for (g = defines; g != NULL; g = g->next)
+		import_define(ctx, g->name, g->value);
+}
+
+static bool
+import_is_defined(ImportScanContext *ctx, const char *name)
+{
+	ImportDefine	*d;
+
+	for (d = ctx->defines; d; d = d->next)
+	{
+		if (strcmp(d->name, name) == 0)
+			return d->value != NULL;
+	}
+	return false;
+}
+
+static void
+import_define(ImportScanContext *ctx, const char *name, const char *value)
+{
+	ImportDefine	*d;
+
+	for (d = ctx->defines; d; d = d->next)
+	{
+		if (strcmp(d->name, name) == 0)
+		{
+			free(d->value);
+			d->value = value ? strdup(value) : NULL;
+			return;
+		}
+	}
+
+	d = (ImportDefine *) malloc(sizeof(ImportDefine));
+	d->name = strdup(name);
+	d->value = value ? strdup(value) : NULL;
+	d->next = ctx->defines;
+	ctx->defines = d;
+}
+
+static void
+import_undefine(ImportScanContext *ctx, const char *name)
+{
+	ImportDefine	*d;
+
+	for (d = ctx->defines; d; d = d->next)
+	{
+		if (strcmp(d->name, name) == 0)
+		{
+			free(d->value);
+			d->value = NULL;
+			return;
+		}
+	}
+
+	/* Record an explicit undefined entry so future #ifdef sees it. */
+	d = (ImportDefine *) malloc(sizeof(ImportDefine));
+	d->name = strdup(name);
+	d->value = NULL;
+	d->next = ctx->defines;
+	ctx->defines = d;
+}
+
+/*
+ * Determine whether the current position starts a struct/union/enum/typedef
+ * definition that we want to extract.
+ */
+static bool
+import_starts_type_definition(ImportScanContext *ctx)
+{
+	const char		 *p = ctx->p;
+	const char		 *q;
+
+	if (import_is_word_at(p, "struct") ||
+		import_is_word_at(p, "union") ||
+		import_is_word_at(p, "enum"))
+	{
+		/*
+		 * It is a real definition if, after the keyword and optional tag, we
+		 * see '{'.  Forward declarations like "struct foo;" are not extracted.
+		 */
+		q = p;
+		/* skip keyword */
+		while (*q && (isalnum((unsigned char) *q) || *q == '_'))
+			q++;
+		/* skip whitespace */
+		while (*q && isspace((unsigned char) *q))
+			q++;
+		/* skip optional tag */
+		if (*q && (isalpha((unsigned char) *q) || *q == '_'))
+		{
+			while (*q && (isalnum((unsigned char) *q) || *q == '_'))
+				q++;
+			while (*q && isspace((unsigned char) *q))
+				q++;
+		}
+		if (*q == '{')
+			return true;
+		return false;
+	}
+
+	if (import_is_word_at(p, "typedef"))
+		return true;
+
+	return false;
+}
+
+/*
+ * Extract a declaration starting at ctx->p and append it to ctx->decls with a
+ * #line directive.  The caller has already verified that this starts a type
+ * definition.
+ */
+static void
+import_extract_declaration(ImportScanContext *ctx)
+{
+	const char		 *start = ctx->p;
+	const char		 *end;
+	int				 start_line = ctx->lineno;
+	int				 brace = ctx->brace_depth;
+	int				 paren = ctx->paren_depth;
+
+	end = ctx->p;
+	while (*end)
+	{
+		if (end[0] == '/' && end[1] == '*')
+		{
+			import_skip_block_comment_at(&end, &ctx->lineno);
+			continue;
+		}
+		if (end[0] == '/' && end[1] == '/')
+		{
+			import_skip_line_comment_at(&end, &ctx->lineno);
+			continue;
+		}
+		if (*end == '"' || *end == '\'')
+		{
+			import_skip_string_at(&end, *end, &ctx->lineno);
+			continue;
+		}
+
+		if (*end == '{')
+			brace++;
+		else if (*end == '}')
+			brace--;
+		else if (*end == '(')
+			paren++;
+		else if (*end == ')')
+			paren--;
+		else if (*end == ';' && brace == 0 && paren == 0)
+		{
+			end++;
+			break;
+		}
+
+		if (*end == '\n')
+			ctx->lineno++;
+		end++;
+	}
+
+	/* Update global depths in case the declaration spanned lines. */
+	ctx->brace_depth = brace;
+	ctx->paren_depth = paren;
+
+	appendStringInfo(&ctx->decls, "#line %d \"%s\"\n", start_line, ctx->filename);
+	appendBinaryStringInfo(&ctx->decls, start, end - start);
+	appendStringInfoChar(&ctx->decls, '\n');
+
+	ctx->p = end;
+}
+
+/*
+ * The following variants operate on explicit pointers and update lineno via
+ * a pointer, so they can be used during declaration extraction without
+ * disturbing ctx->p.
+ */
+static void
+import_skip_block_comment_at(const char **pp, int *lineno)
+{
+	(*pp) += 2;
+	while (**pp)
+	{
+		if ((*pp)[0] == '*' && (*pp)[1] == '/')
+		{
+			(*pp) += 2;
+			return;
+		}
+		if (**pp == '\n')
+			(*lineno)++;
+		(*pp)++;
+	}
+}
+
+static void
+import_skip_line_comment_at(const char **pp, int *lineno)
+{
+	(void) lineno;
+	(*pp) += 2;
+	while (**pp && **pp != '\n')
+		(*pp)++;
+}
+
+static void
+import_skip_string_at(const char **pp, char quote, int *lineno)
+{
+	(*pp)++;
+	while (**pp)
+	{
+		if (**pp == '\\' && (*pp)[1])
+		{
+			(*pp) += 2;
+			continue;
+		}
+		if (**pp == quote)
+		{
+			(*pp)++;
+			return;
+		}
+		if (**pp == '\n')
+			(*lineno)++;
+		(*pp)++;
+	}
+}
