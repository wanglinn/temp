+/*
+ * preproc_import.h
+ *
+ * Tolerant extraction of struct/union/enum/typedef definitions from
+ * C header files included via #include "...", for ECPG host-variable
+ * registration.
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ *
+ * src/interfaces/ecpg/preproc/preproc_import.h
+ */
+
+#ifndef PREPROC_IMPORT_H
+#define PREPROC_IMPORT_H
+
+extern bool import_struct_includes;
+
+extern char *ecpg_extract_struct_decls(const char *filename);
+
+#endif							/* PREPROC_IMPORT_H */
