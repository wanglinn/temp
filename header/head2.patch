 /*
+ * Support for --import-struct-includes: when a #include "..." is seen,
+ * extract struct/union/enum/typedef declarations from the header and feed
+ * them to the parser so ECPG registers the types.  The original #include line
+ * is echoed normally; parser output during registration is suppressed so the
+ * declarations are not duplicated in the generated .c file.
+ */
+static YY_BUFFER_STATE import_reg_buffer = NULL;
+static FILE *import_saved_yyout = NULL;
+static bool import_output_suppressed = false;
+
+static void
+import_check_output_restore(void)
+{
+	if (import_output_suppressed && YY_CURRENT_BUFFER != import_reg_buffer)
+	{
+		if (base_yyout)
+			fclose(base_yyout);
+		base_yyout = import_saved_yyout;
+		import_output_suppressed = false;
+		import_reg_buffer = NULL;
+	}
+}
+
+static void
+process_include_for_structs(const char *yytext)
+{
+	char			  filename[MAXPGPATH];
+	const char		 *p;
+	const char		 *start;
+	const char		 *end;
+	char			 *decls;
+	char			 *wrapped;
+	struct _yy_buffer *yb;
+
+	/* Extract filename between the first pair of double quotes. */
+	p = strchr(yytext, '"');
+	if (!p)
+		return;
+	start = p + 1;
+	end = strchr(start, '"');
+	if (!end || end - start >= MAXPGPATH)
+		return;
+	memcpy(filename, start, end - start);
+	filename[end - start] = '\0';
+
+	decls = ecpg_extract_struct_decls(filename);
+	if (!decls || !decls[0])
+		return;
+
+	fprintf(stderr, "--- extracted from %s ---\n%s\n---\n", filename, decls);
+
+	wrapped = (char *) mm_alloc(strlen(decls) + 128);
+	sprintf(wrapped,
+			"EXEC SQL BEGIN DECLARE SECTION;\n"
+			"%s"
+			"EXEC SQL END DECLARE SECTION;\n",
+			decls);
+	fprintf(stderr, "--- wrapped ---\n%s\n---\n", wrapped);
+
+	/* Suppress parser output while the synthetic declarations are parsed. */
+	import_saved_yyout = base_yyout;
+	base_yyout = tmpfile();
+	if (!base_yyout)
+		mmfatal(NO_INCLUDE_FILE, "could not create temp file for import");
+
+	yb = (struct _yy_buffer *) mm_alloc(sizeof(struct _yy_buffer));
+	yb->buffer = yy_scan_string(wrapped);
+	yb->lineno = yylineno;
+	yb->filename = mm_strdup(input_filename);
+	yb->next = yy_buffer;
+	yy_buffer = yb;
+
+	yy_switch_to_buffer(yb->buffer);
+	yylineno = 1;
+	free(input_filename);
+	input_filename = mm_strdup(filename);
+	import_reg_buffer = YY_CURRENT_BUFFER;
+	import_output_suppressed = true;
+
+	BEGIN(C);
+}
+
