@@ -0,0 +1,22 @@
+#include <stdio.h>
+#include "import_structs.h"
+
+EXEC SQL INCLUDE sqlca;
+
+int
+main(void)
+{
+	EXEC SQL BEGIN DECLARE SECTION;
+	MYTYPE			rec;
+	struct inner_type inner;
+#ifdef USE_FEATURE
+	FEATURE_REC		frec;
+#endif
+	EXEC SQL END DECLARE SECTION;
+
+	printf("sizes: %zu %zu\n", sizeof(rec), sizeof(inner));
+
+	EXEC SQL CONNECT TO tcp:postgresql://localhost/postgres;
+
+	return 0;
+}
