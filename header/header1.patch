#2 
上面有个问题， pc 文件内容
#include <stdio.h>

#include <string.h>

上面修改后， 发现在生成的.c文件中，这两个头文件被展开了，实际上不需要展开， 也就是 只要是 #include <xx.h> 这种的 就不需要开展


》 明白了，只需要在 parse_include() 函数中添加 4 行代码，判断 yytext[0] == '<' 时直接输出

--- a/src/interfaces/ecpg/preproc/pgc.l
+++ b/src/interfaces/ecpg/preproc/pgc.l
@@ -1703,6 +1703,15 @@ parse_include(void)
 	/* got the include file name */
 	struct _yy_buffer *yb;
 	struct _include_path *ip;
+
+	/* #include <...> format: output directly to .c file, do not parse/expand */
+	if (yytext[0] == '<')
+	{
+		fprintf(yyout, "#include %s\n", yytext);
+		BEGIN(C);
+		return;
+	}
+
 	char		inc_file[MAXPGPATH];
 	unsigned int i;

#3 
上面修改 验证如下场景没问题，符合预期， PC 文件如下
#include <stdio.h>

#include <string.h>



#include "h1.h"

#include "h2.h"



，但是下面场景不符合预期，PC 文件为
EXEC SQL INCLUDE sqlca;

EXEC SQL INCLUDE sqlda;



发现只对 sqlca 进行了展开，EXEC SQL INCLUDE sqlda; 对应输出内容为 #include sqlda;


若PC 文件为

EXEC SQL INCLUDE sqlca;

EXEC SQL INCLUDE sqlda;

则在 parse_include 处理时，发现

sqlca 不会进入  	if (current_file_is_system_header || current_file_is_angle_bracket)
 	{

而 sqlda 则会进入 这个if 语句块内

》 请确认：你当前的 pgc.l 中，<<EOF>> 部分是否有 current_file_is_system_header = yb->is_system_header; 这行代码？
如果有，就修改为：

current_file_is_angle_bracket = (yb->next != NULL) ? yb->next->is_angle_bracket : false;
current_file_is_system_header = (yb->next != NULL) ? yb->next->is_system_header : false;


 


